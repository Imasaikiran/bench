{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "tiers", "chapters"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tiers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/tier" }
    },
    "chapters": {
      "type": "object",
      "required": ["Foundation", "Automation", "Delegation", "Craft", "Coherence"],
      "additionalProperties": false,
      "properties": {
        "Foundation": { "$ref": "#/$defs/chapter" },
        "Automation": { "$ref": "#/$defs/chapter" },
        "Delegation": { "$ref": "#/$defs/chapter" },
        "Craft": { "$ref": "#/$defs/chapter" },
        "Coherence": { "$ref": "#/$defs/chapter" }
      }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": ["slot_labels", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "slot_labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 5,
          "maxItems": 5
        },
        "dimensions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/dimension" }
        }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["id", "name", "weight", "have_criteria", "partial_criteria", "rationale", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 25 },
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "have_criteria": { "type": "string", "minLength": 1 },
        "partial_criteria": { "type": ["string", "null"] },
        "rationale": { "type": "string", "minLength": 10 },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tier": {
      "type": "object",
      "required": ["name", "conditions"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["Explorer", "Tinkerer", "Craftsman", "Operator", "Conductor"] },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    }
  }
}
