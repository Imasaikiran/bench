# bench — environment variables
#
# Copy this file to web/.env.local for local dev. Never commit real secrets.
# Each var is annotated with: purpose, where it's read (file:line), required?, example.
# All paths are relative to the repo root.

# ---------------------------------------------------------------------------
# Database (Neon Postgres, serverless driver)
# ---------------------------------------------------------------------------

# Postgres connection string used by the web app and the migration runner.
# Read in: web/lib/db.ts:7, web/migrations/run.ts:10,17
# Required for: any route that hits the DB (api/scan, api/claim, api/delete,
#               api/feedback, api/cron/expire, /scan/[id], /u/[handle]).
# Optional for: pages that don't touch the DB (/, /demo, /how-we-scored,
#               /rubric, /scan/local).
# Example: postgres://user:password@ep-foo-bar.us-east-2.aws.neon.tech/bench?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# GitHub OAuth (claim flow — link an anonymous scan to a @handle)
# ---------------------------------------------------------------------------

# OAuth app credentials from https://github.com/settings/developers.
# Read in: web/lib/github.ts:139-140, web/app/api/auth/github/route.ts:26
# Required for: /api/auth/github (login + callback), claim flow.
# Optional for: every other route.
# Example: Iv1.abc123def456
GITHUB_CLIENT_ID=
# Example: ghs_AbCdEf0123456789AbCdEf0123456789AbCd
GITHUB_CLIENT_SECRET=

# HMAC key used to sign the OAuth `state` token (CSRF protection).
# Read in: web/lib/github.ts:9 (sign + verify state).
# Required whenever GitHub OAuth is used. Rotate independently of the
# GitHub client secret. Generate with: openssl rand -hex 32
# Example: 4f3c1a... (64 hex chars)
OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------------
# Public origin (canonical URL used in OG cards, share links, redirects)
# ---------------------------------------------------------------------------

# The canonical origin where the app is served. Defaults to https://bench.dev.
# Read in: web/lib/v1render.tsx:34, web/app/scan/[id]/page.tsx:10,
#          web/app/u/[handle]/page.tsx:10
# Required for: production deploys on a non-default domain.
# Optional for: local dev (default fallback works for share-link copy).
# Example (local): http://localhost:3000
# Example (prod):  https://bench.dev
BENCH_PUBLIC_ORIGIN=

# ---------------------------------------------------------------------------
# Rate-limit cron (Vercel Cron expires anonymous scans nightly)
# ---------------------------------------------------------------------------

# Shared secret that protects /api/cron/expire — request must include
# `Authorization: Bearer <CRON_SECRET>`. Vercel Cron sends this automatically
# when configured in vercel.json.
# Read in: web/app/api/cron/expire/route.ts:8
# Required for: production cron. Omit locally — the route refuses to run.
# Example: long-random-string-rotated-quarterly
CRON_SECRET=

# ---------------------------------------------------------------------------
# Metrics auth (basic auth on /internal/metrics — founder-only dashboard)
# ---------------------------------------------------------------------------

# HTTP Basic credentials gating the /internal/* routes via middleware.
# Read in: web/middleware.ts:10-11
# Required for: accessing /internal/metrics in any environment where the
#               middleware is active. If unset, middleware blocks access.
# Example user: founder
METRICS_USER=
# Example pass: change-me-locally
METRICS_PASS=

# ---------------------------------------------------------------------------
# Plausible (analytics — used to render the founder metrics page)
# ---------------------------------------------------------------------------

# Plausible API key (server-side stats fetch on the metrics page).
# Read in: web/app/internal/metrics/page.tsx:37
# Required for: /internal/metrics to display real stats. If unset, the page
#               renders with empty data.
# Example: plausible-api-key-from-dashboard
PLAUSIBLE_API_KEY=

# Plausible site domain (which site to query). Defaults to bench.dev.
# Read in: web/app/internal/metrics/page.tsx:36
# Optional. Set when querying a non-prod Plausible site (e.g. staging).
# Example: bench.dev
PLAUSIBLE_DOMAIN=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------

# Set to "1" to flip the app into over-capacity mode — /api/scan and
# /api/feedback return 503 and the /over-capacity page is shown. Used as
# the Vercel-spending-cap fallback (plan §1.35).
# Read in: web/app/api/scan/route.ts:17, web/app/api/feedback/route.ts:16
# Optional. Default is off.
# Example: 1
OVER_CAPACITY=

# Path to a bench-scan.json file to render via the debug-only /scan/local route.
# Defaults to /tmp/bench-real-run/bench-scan.json.
# Read in: web/app/scan/local/page.tsx:27
# Optional. Local-dev only — the route is noindex and not exposed in prod.
# Example: /Users/me/bench-scan.json
BENCH_LOCAL_SCAN=

# Standard Next.js node env. Affects cookie `Secure` flag in OAuth + delete flows.
# Read in: web/app/api/auth/github/route.ts:47,104, web/app/api/delete/route.ts:99
# Optional locally (Next sets it). Set to "production" in prod deploys.
# Example: production
NODE_ENV=

# ---------------------------------------------------------------------------
# Sentry (error monitoring — fully optional, app behaves identically when unset)
# ---------------------------------------------------------------------------

# Sentry DSN. When unset, Sentry init is a no-op everywhere — no captures,
# no spam. Set this to enable error capture on the live failure surfaces
# (api/scan, api/og/[id], api/auth/github, api/claim, app/error.tsx).
# Read in: web/sentry.{client,server,edge}.config.ts, web/lib/sentry-capture.ts
# Optional. Default is off.
# Example: https://abc123@o0.ingest.sentry.io/0
SENTRY_DSN=

# Performance traces sample rate. Float between 0 and 1. Defaults to 0.1.
# Read in: web/sentry.{client,server,edge}.config.ts
# Optional.
# Example: 0.1
SENTRY_TRACES_SAMPLE_RATE=

# Sentry auth token used at build time to upload source maps. When unset,
# source map upload is skipped (handled inside web/next.config.js).
# Read in: web/next.config.js
# Optional. Generate at https://sentry.io/settings/account/api/auth-tokens/
# Example: sntrys_eyJ...
SENTRY_AUTH_TOKEN=

# Sentry org + project slugs (only used at build time alongside
# SENTRY_AUTH_TOKEN, for source map upload).
# Read in: web/next.config.js
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# CLI environment (read by cli/, not needed for the web app)
# ---------------------------------------------------------------------------

# Override the directory the CLI scans. Defaults to ~/.claude/.
# Read in: cli/src/env.ts:31
# Optional. Useful for testing against fixture .claude/ trees.
# Example: /tmp/fixtures/operator/.claude
CLAUDE_HOME=

# CI-detection vars — the CLI refuses to run when any of these are truthy
# (scanning a CI runner is meaningless). You should NOT set these locally.
# Read in: cli/src/env.ts:11-19,26-29
# Vars: CI, GITHUB_ACTIONS, GITLAB_CI, CIRCLECI, BUILDKITE, TRAVIS, JENKINS_URL

# ---------------------------------------------------------------------------
# CLI test-only env (used by Vitest, not by end users)
# ---------------------------------------------------------------------------

# Set to "1" to enable the live end-to-end CLI test against a running web app.
# Read in: cli/test/e2e.test.ts:38
# Optional. CI runs this with BENCH_URL pointing at a preview deploy.
BENCH_E2E=

# Override the upload endpoint used by the e2e test. Defaults to
# http://localhost:3000.
# Read in: cli/test/e2e.test.ts:39
# Optional. Only meaningful with BENCH_E2E=1.
BENCH_URL=

# Set to "1" to regenerate snapshot fixtures in cli/test/snapshots/.
# Read in: cli/test/snapshot.test.ts:39
# Optional. Use when intentionally changing scoring output.
UPDATE_SNAPSHOTS=

# ---------------------------------------------------------------------------
# Note on BENCH_HMAC_KEY
# ---------------------------------------------------------------------------
# BENCH_HMAC_KEY is intentionally NOT an env var. The HMAC integrity key is
# hard-coded as a public constant ("bench-v1-integrity-key-public-do-not-treat-
# as-secret") in cli/src/payload.ts:7 and web/lib/hmac.ts:5. It exists to
# deter casual payload tampering, not as an authentication secret. Do not
# treat it as a credential and do not move it to env — both sides must agree
# on the same constant for client_hmac verification to work.
